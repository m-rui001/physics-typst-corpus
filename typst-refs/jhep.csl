<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="never">
  <info>
    <title>JHEP</title>
    <id>http://local/jhep</id>
    <updated>2024-01-01T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name delimiter=", " and="text" delimiter-precedes-last="never" et-al-min="7" et-al-use-first="6"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=", ">
        <text macro="author"/>
        <text variable="title" font-style="italic"/>
        <choose>
          <if variable="container-title">
            <group delimiter=" ">
              <text variable="container-title"/>
              <text variable="volume"/>
              <date variable="issued" prefix="(" suffix=")">
                <date-part name="year"/>
              </date>
              <text variable="page"/>
              <text variable="note"/>
            </group>
          </if>
          <else>
            <text variable="note"/>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
