<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="never">
  <info>
    <title>aps-numeric</title>
    <id>http://local/aps-numeric</id>
    <updated>2026-01-01T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" initialize-with=". " delimiter=", " and="symbol" delimiter-precedes-last="never" et-al-min="6" et-al-use-first="1"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=" ">
        <text macro="author" suffix="."/>
        <choose>
          <if variable="container-title">
            <group delimiter=" ">
              <text variable="title" suffix="."/>
              <group delimiter=" ">
                <text variable="container-title" font-style="italic"/>
                <group delimiter=" ">
                  <text variable="volume" font-weight="bold" suffix=","/>
                  <text variable="page"/>
                </group>
                <date variable="issued">
                  <date-part name="year" prefix="(" suffix=")"/>
                </date>
              </group>
            </group>
          </if>
          <else-if variable="publisher">
            <group delimiter=" ">
              <text variable="title" font-style="italic" suffix="."/>
              <group prefix="(" suffix=")" delimiter=", ">
                <text variable="publisher"/>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
              </group>
            </group>
          </else-if>
          <else>
            <group delimiter=" ">
              <text variable="title" suffix="."/>
              <text variable="note"/>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
