#figure(
  cetz.canvas(length: 0.85cm, {
    import cetz.draw: *
    set-style(stroke: (paint: black, thickness: 0.55pt))
    let spin(x, y) = {
      line((x + 0.09, y), (x + 0.44, y), mark: (end: ">"))
      circle((x, y), radius: 0.075, fill: white)
    }
    rect((0.35, 2.95), (3.85, 3.7), fill: green.lighten(72%))
    rect((0.35, 1.15), (3.85, 1.9), fill: red.lighten(76%))
    for x in range(4) {
      spin(0.7 + x * 0.9, 3.32)
      spin(0.7 + x * 0.9, 1.52)
    }
    content((4.05, 3.32), text(fill: green.darken(15%))[Gain], anchor: "west")
    content((4.05, 1.52), text(fill: red.darken(15%))[Loss], anchor: "west")
    line((0.55, 1.92), (0.55, 2.93), stroke: 0.4pt, mark: (start: "|", end: "|"))
    content((0.45, 2.42), $d$, anchor: "east")
    line((2.5, 1.92), (2.5, 2.93), mark: (start: "stealth", end: "stealth"))
    content((2.6, 2.42), $J$, anchor: "west")
    line((0.55, 0.6), (3.6, 0.6), stroke: 1.5pt, mark: (end: "stealth"))
    content((2.1, 0.85), $bold(m)_0 parallel hat(x)$)
    content((2.1, 0.18), "(a)")
    line((5.6, 0.85), (9.7, 0.85), mark: (end: ">"))
    line((5.6, 0.85), (5.6, 4.05), mark: (end: ">"))
    content((9.85, 0.85), $alpha$, anchor: "west")
    content((5.5, 3.95), $omega_(1, 2)$, anchor: "east")
    line((7.0, 0.85), (7.0, 3.55), stroke: (paint: gray, dash: "dashed", thickness: 0.4pt))
    line((8.35, 0.85), (8.35, 3.3), stroke: (paint: gray, dash: "dashed", thickness: 0.4pt))
    content((7.0, 0.7), $alpha_c$, anchor: "north")
    content((8.35, 0.7), $alpha_c$, anchor: "north")
    bezier((5.7, 3.0), (7.0, 2.6), (6.2, 3.0), (6.95, 2.72), stroke: 1pt + blue)
    bezier((5.7, 2.15), (7.0, 2.6), (6.2, 2.15), (6.95, 2.48), stroke: 1pt + blue)
    bezier((7.0, 2.6), (9.4, 2.8), (8.2, 2.72), stroke: 1pt + blue)
    bezier((7.0, 2.6), (9.4, 3.55), (7.9, 3.2), stroke: (paint: blue, thickness: 1pt, dash: "dashed"))
    bezier((7.0, 2.6), (9.4, 1.65), (7.9, 2.0), stroke: (paint: blue, thickness: 1pt, dash: "dashed"))
    circle((7.0, 2.6), radius: 0.05, fill: blue, stroke: none)
    bezier((5.7, 2.9), (8.35, 2.62), (6.3, 2.9), (7.7, 2.66), stroke: 1pt + red)
    bezier((5.7, 2.25), (8.35, 2.62), (6.3, 2.25), (7.7, 2.58), stroke: 1pt + red)
    bezier((8.35, 2.62), (9.4, 2.7), (8.9, 2.66), stroke: 1pt + red)
    bezier((8.35, 2.62), (9.4, 3.2), (8.7, 2.95), stroke: (paint: red, thickness: 1pt, dash: "dashed"))
    bezier((8.35, 2.62), (9.4, 2.05), (8.7, 2.3), stroke: (paint: red, thickness: 1pt, dash: "dashed"))
    circle((8.35, 2.62), radius: 0.05, fill: red, stroke: none)
    line((6.05, 4.42), (6.4, 4.42), stroke: 1pt + blue)
    content((6.5, 4.42), text(size: 7pt, fill: blue, $bold(k)_1 = [pi\/6 d, pi\/4 d]$), anchor: "west")
    line((6.05, 4.12), (6.4, 4.12), stroke: 1pt + red)
    content((6.5, 4.12), text(size: 7pt, fill: red, $bold(k)_2 = [pi\/6 d, pi\/6 d]$), anchor: "west")
    line((8.75, 4.42), (9.1, 4.42), stroke: 1pt)
    content((9.2, 4.42), text(size: 7pt)[Re $omega$], anchor: "west")
    line((8.75, 4.12), (9.1, 4.12), stroke: (dash: "dashed"))
    content((9.2, 4.12), text(size: 7pt)[Im $omega$], anchor: "west")
    content((7.6, 0.15), "(b)")
    line((10.5, 0.85), (13.65, 0.85), mark: (end: ">"))
    line((10.5, 0.85), (10.5, 4.05), mark: (end: ">"))
    content((13.8, 0.85), $alpha_c$, anchor: "west")
    content((10.22, 2.45), "mode", angle: 90deg)
    circle((12.05, 2.5), radius: (1.12, 0.85), fill: yellow.lighten(60%), stroke: none)
    circle((12.05, 2.5), radius: (0.68, 0.52), fill: orange.lighten(30%), stroke: none)
    circle((12.05, 2.5), radius: (0.32, 0.25), fill: red.lighten(10%), stroke: none)
    circle((12.05, 2.5), radius: (1.12, 0.85), stroke: (paint: gray, dash: "dotted", thickness: 0.4pt))
    content((12.05, 3.75), text(size: 7pt)[$cal("PT")$ unbroken])
    content((12.05, 2.5), text(size: 6.5pt, fill: white, weight: "bold")[PT broken])
    content((11.95, 0.18), "(c)")
  }),
  caption: [(a) Schematic plot of a bilayer ferromagnet with balanced gain and loss. The magnetization of all spins is initially along the $x$-direction. (b) Evolution of $omega_(1, 2)$ as a function of $alpha$ for two representative spin-wave modes $bold(k) = [pi\/6 d, pi\/4 d]$ (blue curves) and $[pi\/6 d, pi\/6 d]$ (red curves). (c) Contour plot of the mode dependence on $alpha_c$; $cal("PT")$ symmetry is never broken in the white region. The figures are adapted from Ref. @YangPRL2018.],
)
