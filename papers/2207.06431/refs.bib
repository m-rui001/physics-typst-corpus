@article{Gutierrez-Svec-Vargo-Brown-2013,
  author =        {Gutiérrez, Mauricio and Svec, Lukas and Vargo, Alexander and Brown, Kenneth R.},
  journal =       {Phys. Rev. A},
  pages =         {⁠030302},
  publisher =     {American Physical Society},
  title =         {Approximation of realistic errors by {C}lifford channels and {P}auli measurements},
  volume =        {87},
  year =          {2013},
  annote =        {The Gottesman-Knill theorem allows for the efficient
                   simulation of stabilizer-based quantum
                   error-correction circuits. Errors in these circuits
                   are commonly modeled as depolarizing channels by
                   using Monte Carlo methods to insert Pauli gates
                   randomly throughout the circuit. Although convenient,
                   these channels are poor approximations of common,
                   realistic channels such as amplitude damping. Here we
                   analyze a larger set of efficiently simulable error
                   channels by allowing the random insertion of any
                   one-qubit gate or measurement that can be efficiently
                   simulated within the stabilizer formalism. Our error
                   channels are shown to be a viable method for
                   accurately approximating realistic error channels.},
  doi =           {10.1103/PhysRevA.87.030302},
  url =           {https://link.aps.org/doi/10.1103/PhysRevA.87.030302}
}
