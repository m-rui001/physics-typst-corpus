#align(center)[
  #text(12pt, weight: "bold", [Scalar-induced gravitational wave interpretation of PTA data: \ the role of scalar fluctuation propagation speed])   #v(1.2em)
  #text(10.5pt)[Shyam Balaji#super[a, b]#super[1], Guillem Domènech#super[c]#super[1], Gabriele Franciolini#super[d]#super[1]]

]
#block(spacing: 0.45em)[
