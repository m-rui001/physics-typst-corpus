@article{Wilczek2012,
abstract = {Some subtleties and apparent difficulties associated with the notion of spontaneous breaking of time-translation symmetry in quantum mechanics are identified and resolved. A model exhibiting that phenomenon is displayed. The possibility and significance of breaking of imaginary time-translation symmetry is discussed. {©} 2012 American Physical Society.},
