@article{Asplund:2009eu,
  author = {Asplund, M. and Grevesse, N. and Sauval, A. J. and Scott, P.},
  title = {{The Chemical Composition of the Sun}},
  journal = {Annu. Rev. Astro. Astrophys.},
  year = {2009},
  volume = {47},
  number = {1},
  pages = {481--522},
  month = {Sep},
  publisher = {Annual Reviews},
  doi = {10.1146/annurev.astro.46.060407.145222},
  language = {English},
  rating = {0},
  date-added = {2018-12-05T12:42:11GMT},
  date-modified = {2018-12-05T12:43:04GMT},
  abstract = {The solar chemical composition is an important ingredient in our understanding of the formation, structure, and evolution of both the Sun and our Solar System. Furthermore, it is an essential reference standard against which the elemental contents of other astronomical objects are compared. In this review, we evaluate the current understanding of the solar photospheric composition. In particular, we present a redetermination of the abundances of nearly all available elements, using a realistic new three-dimensional (3D), time-dependent hydrodynamical model of the solar atmosphere. We have carefully considered the atomic input data and selection of spectral lines, and accounted for departures from local thermodynamic equilibrium (LTE) whenever possible. The end result is a comprehensive and homogeneous compilation of the solar elemental abundances. Particularly noteworthy findings are significantly lower abundances of C, N, O, and Ne compared to the widely used values of a decade ago. The new solar chemica...},
  url = {http://www.annualreviews.org/doi/10.1146/annurev.astro.46.060407.145222},
}


@article{RossiTorres:2015wh,
  author = {Rossi-Torres, F. and Guzzo, M. M. and Kemp, E.},
  title = {{Boundaries on Neutrino Mass from Supernovae Neutronization Burst by Liquid Argon Experiments}},
  journal = {arXiv},
  year = {2015},
  eprint = {1501.00456v1},
  eprinttype = {arxiv},
  eprintclass = {hep-ph},
  month = {Jan},
  annote = {7 pages, 2 figures and 1 table},
  read = {Yes},
  rating = {0},
  date-added = {2018-12-13T20:23:01GMT},
  date-modified = {2018-12-13T20:23:41GMT},
  abstract = {This work presents an upper bound on the neutrino mass using the emission of $\nu$e from the neutronization burst of a core collapsing supernova at 10{\textasciitilde}kpc of distance and a progenitor star of 15{\textasciitilde}M_. The calculations were done considering a 34 kton Liquid Argon Time Projection Chamber similar to the Far Detector proposal of the Long Baseline Neutrino Experiment (LBNE). We have performed a Monte Carlo simulation for the number of events integrated in 5{\textasciitilde}ms bins. Our results are m$\nu$<2.71{\textasciitilde}eV and 0.18{\textasciitilde}{eV}<m$\nu$<1.70{\textasciitilde}eV, at 95\% C.L, assuming normal hierarchy and inverted hierarchy, respectively. We have analysed different configurations for the detector performance resulting in neutrino mass bound of O(1){\textasciitilde}eV.},
  url = {http://arxiv.org/abs/1501.00456v1},
}


