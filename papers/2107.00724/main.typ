#figure(
  image("figures/KLD.png", width: 45%),
  caption: [Experimentally measured irreversibility metric (see @eq:relent) as a function of measurement frequency shows a peak around the timescale of nonequilibrium activity. Adapted from Ref. @Tan2021KLD.],
